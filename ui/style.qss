/* 主卡片 */
QWidget#mainWindow,
QDialog#settingsWindow,
QDialog#logWindow,
QDialog#screenshotWindow,
QDialog#initWindow,
QDialog#updateWindow,
QDialog#messageDialog {
    background-color: #262a31;
}

QFrame#card, QFrame#settingsCard, QFrame#logCard, QFrame#screenshotCard, QFrame#initCard, QFrame#updateCard {
    background-color: #262a31;
    border: 1px solid #1b1e24;
    border-radius: 0px;
}

QToolTip {
    background-color: #1f2228;
    color: #e8ebf0;
    border: 1px solid #3a414d;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
}

QWidget#configListBg {
    background-color: #202329;
    border-bottom: 1px solid #171a20;
}

QScrollArea#configScrollArea {
    background-color: #202329;
    border: none;
    border-bottom: 1px solid #171a20;
}
QScrollArea#configScrollArea > QWidget > QWidget {
    background-color: #202329;
}
QScrollArea#configScrollArea QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 1px 4px 0;
}
QScrollArea#configScrollArea QScrollBar::handle:vertical {
    background-color: #4d5563;
    border-radius: 3px;
    min-height: 24px;
}
QScrollArea#configScrollArea QScrollBar::handle:vertical:hover {
    background-color: #667085;
}
QScrollArea#configScrollArea QScrollBar::add-line:vertical,
QScrollArea#configScrollArea QScrollBar::sub-line:vertical,
QScrollArea#configScrollArea QScrollBar::add-page:vertical,
QScrollArea#configScrollArea QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QWidget#compactCtrlBg {
    background-color: #191c21;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom: 1px solid #111419;
}

QWidget#mainBottomBg {
    background-color: #2b2d33;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

/* 窗口控制区 */
QWidget#windowCtrlBg {
    background-color: #191c21;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom: 1px solid #111419;
}

QWidget#topBg {
    background-color: #202329;
    border-bottom: 1px solid #171a20;
}

QWidget#settingsTopBg, QWidget#logTopBg, QWidget#screenshotTopBg, QWidget#initTopBg, QWidget#updateTopBg {
    background-color: #191c21;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom: 1px solid #111419;
}

/* 中下区域背景 */
QWidget#midBg, QWidget#settingsFormBg, QWidget#screenshotBodyBg, QWidget#initBodyBg, QWidget#updateBodyBg {
    background-color: transparent;
    border: none;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QLabel#configLabel {
    color: #f0f0f0;
    font-size: 14px;
    background: transparent;
    border: none;
}

QLabel#statusLabel {
    color: #c8ccd5;
    font-size: 13px;
    background: transparent;
}

QLabel#sectionTitle, QLabel#settingsTitle {
    color: #8b8f99;
    font-size: 12px;
    background: transparent;
}

QLabel#settingsTitle, QLabel#logTitle, QLabel#screenshotTitle, QLabel#initTitle, QLabel#updateTitle {
    color: #c8ccd5;
    font-size: 12px;
    font-weight: normal;
    font-family: "Microsoft YaHei", "Segoe UI";
}

QLabel#initDesc, QLabel#initHint {
    color: #c8ccd5;
    font-size: 13px;
    background: transparent;
}

QLabel#initStepProgress {
    color: #42d392;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#initStepTitle {
    color: #f1f4f8;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

QLabel#initStepDesc {
    color: #aeb5c1;
    font-size: 13px;
    background: transparent;
    line-height: 1.4;
}

QFrame#initStepRail {
    background-color: #1f232a;
    border: 1px solid #303640;
    border-radius: 8px;
}

QFrame#initStepNavItem {
    background: transparent;
    border: none;
}

QLabel#initStepBadge {
    background-color: #2a3039;
    color: #aeb5c1;
    border: 1px solid #3a414d;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#initStepBadge[active="true"] {
    background-color: #47d99a;
    color: #0f1419;
    border: 1px solid #47d99a;
}
QLabel#initStepBadge[done="true"] {
    background-color: #173126;
    color: #42d392;
    border: 1px solid #2f7d61;
}

QLabel#initStepNavLabel {
    color: #8f96a3;
    font-size: 12px;
    background: transparent;
}
QLabel#initStepNavLabel[active="true"] {
    color: #f1f4f8;
    font-weight: 600;
}
QLabel#initStepNavLabel[done="true"] {
    color: #42d392;
}

QLabel#initSubtle {
    color: #8f96a3;
    font-size: 12px;
    background: transparent;
}

QStackedWidget#initStepStack, QWidget#initStepPage {
    background: transparent;
}

QFrame#initPanel {
    background-color: #1f232a;
    border: 1px solid #303640;
    border-radius: 6px;
}

QFrame#initEmergencyPanel {
    background-color: #1a1d23;
    border: 1px solid #2d333d;
    border-radius: 6px;
}

QLabel#initPanelTitle {
    color: #d9dee7;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QLabel#initStatus {
    color: #8b8f99;
    font-size: 12px;
    background: transparent;
}
QLabel#initStatus[state="success"] {
    color: #42d392;
}
QLabel#initStatus[state="error"] {
    color: #ff6b6b;
}

QLabel#formLabel {
    color: #c8ccd5;
    font-size: 13px;
}

QLabel#settingsSectionLabel {
    color: #42d392;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    padding-top: 2px;
}

QFrame#settingsSidebar {
    background-color: #1f232a;
    border: 1px solid #303640;
    border-radius: 8px;
}

QPushButton#settingsNavButton {
    background-color: transparent;
    color: #aeb5c1;
    border: 1px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 12px;
    font-size: 13px;
}
QPushButton#settingsNavButton:hover {
    background-color: #282d36;
    color: #f1f4f8;
}
QPushButton#settingsNavButton[active="true"] {
    background-color: #173126;
    color: #42d392;
    border: 1px solid #2f7d61;
    font-weight: 600;
}
QPushButton#settingsNavButton:focus {
    outline: none;
}

QStackedWidget#settingsStack, QWidget#settingsPage {
    background: transparent;
}

QWidget#settingsPageHeader {
    background: transparent;
}

QLabel#settingsPageTitle {
    color: #f1f4f8;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}

QLabel#settingsPageDesc {
    color: #8f96a3;
    font-size: 12px;
    background: transparent;
}

QFrame#settingsPanel {
    background-color: #1f232a;
    border: 1px solid #303640;
    border-radius: 8px;
}

QLabel#sliderValueLabel {
    color: #aeb5c0;
    font-size: 12px;
    background: transparent;
}

/* 配置下拉框 */
QComboBox {
    background: transparent;
    border: none;
    color: transparent;
    font-size: 14px;
    padding: 0px;
}
QComboBox::drop-down {
    border: none;
    width: 0px;
}
QComboBox QAbstractItemView {
    background-color: #1f2228;
    color: #e6e6e6;
    border: 1px solid #171a20;
    selection-background-color: #1b1f26;
    font-size: 13px;
    padding: 4px;
}

/* 底部图标按钮 */
QPushButton.iconBtn {
    background-color: transparent;
    border: none;
    outline: none;
}
QPushButton.iconBtn:hover {
    background-color: rgba(255, 255, 255, 12);
    border: none;
}
QPushButton.iconBtn:focus {
    outline: none;
    border: none;
}

QPushButton#lineIconBtn, BottomIconButton#lineIconBtn, #lineIconBtn {
    background-color: transparent;
    border: none;
    outline: none;
}
QPushButton#lineIconBtn:hover, BottomIconButton#lineIconBtn:hover, #lineIconBtn:hover {
    background-color: #2a2e36;
    border: none;
}
QPushButton#lineIconBtn:pressed, BottomIconButton#lineIconBtn:pressed, #lineIconBtn:pressed {
    background-color: #343a46;
    border: none;
}
QPushButton#lineIconBtn:focus, BottomIconButton#lineIconBtn:focus, #lineIconBtn:focus {
    outline: none;
    border: none;
}

/* Unicode 文本图标按钮 */
QPushButton#unicodeIconBtn {
    background-color: transparent;
    border: none;
    color: #a6abb4;
    font-size: 22px;
    font-family: "Segoe UI Symbol", "Segoe UI", "Microsoft YaHei";
    padding-bottom: 2px;
}
QPushButton#unicodeIconBtn:hover {
    color: #d4d8df;
}
QPushButton#unicodeIconBtn:focus {
    outline: none;
}

/* 设置窗口关闭按钮 */
QPushButton#settingsCloseBtn, QPushButton#logCloseBtn, QPushButton#initCloseBtn, QPushButton#updateCloseBtn {
    background: transparent;
    border: none;
    color: #a6abb4;
    font-size: 14px;
    font-weight: normal;
    padding: 0px;
}
QPushButton#settingsCloseBtn:hover, QPushButton#logCloseBtn:hover:hover, QPushButton#initCloseBtn:hover, QPushButton#updateCloseBtn:hover {
    background-color: #c42b1c;
    color: #ffffff;
}
QPushButton#settingsCloseBtn:pressed, QPushButton#logCloseBtn:pressed:pressed, QPushButton#initCloseBtn:pressed, QPushButton#updateCloseBtn:pressed {
    background-color: #9f2318;
    color: #ffffff;
}
QPushButton#settingsCloseBtn:focus, QPushButton#logCloseBtn:focus:focus, QPushButton#initCloseBtn:focus, QPushButton#updateCloseBtn:focus {
    outline: none;
}

/* 表单输入框 */
QLineEdit {
    background-color: #1a1d22;
    border: 1px solid #14171a;
    border-radius: 4px;
    color: #f0f0f0;
    padding: 4px 8px;
    font-size: 13px;
}
QLineEdit:focus {
    border: 1px solid #42d392;
}

QLineEdit#settingsInput {
    background-color: #171a20;
    border: 1px solid #2f3540;
    border-radius: 6px;
    color: #f3f6fb;
    padding: 0px 10px;
    font-size: 13px;
    selection-background-color: #2f7d61;
}
QLineEdit#settingsInput:hover {
    background-color: #1a1e25;
    border: 1px solid #3b4350;
}
QLineEdit#settingsInput:focus {
    background-color: #171b22;
    border: 1px solid #42d392;
}
QComboBox#settingsInput {
    background-color: #171a20;
    border: 1px solid #2f3540;
    border-radius: 6px;
    color: #f3f6fb;
    padding: 0px 28px 0px 10px;
    font-size: 13px;
    selection-background-color: #2f7d61;
}
QComboBox#settingsInput:hover {
    background-color: #1a1e25;
    border: 1px solid #3b4350;
}
QComboBox#settingsInput:focus {
    background-color: #171b22;
    border: 1px solid #42d392;
}
QComboBox#settingsInput::drop-down {
    border: none;
    width: 24px;
}
QComboBox#settingsInput QAbstractItemView {
    background-color: #1f2228;
    color: #e6e6e6;
    border: 1px solid #2f3540;
    selection-background-color: #2f7d61;
    font-size: 13px;
}

/* 复选框 */
QCheckBox {
    color: #c8ccd5;
    font-size: 13px;
    spacing: 7px;
    min-height: 22px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 5px;
    border: 1px solid #30343f;
    background-color: #1a1d22;
}
QCheckBox::indicator:hover {
    border: 1px solid #42d392;
}
QCheckBox::indicator:checked {
    background-color: #1a1d22;
    border: 1px solid #42d392;
    image: none;
}
QCheckBox::indicator:checked:hover {
    border: 1px solid #54e6a5;
}

QSlider#settingsSlider::groove:horizontal {
    height: 4px;
    background-color: #171a20;
    border: 1px solid #30343f;
    border-radius: 3px;
}
QSlider#settingsSlider::sub-page:horizontal {
    background-color: #42d392;
    border-radius: 3px;
}
QSlider#settingsSlider::add-page:horizontal {
    background-color: #171a20;
    border-radius: 3px;
}
QSlider#settingsSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -6px 0px;
    background-color: #d8dee8;
    border: 1px solid #4b5563;
    border-radius: 7px;
}
QSlider#settingsSlider::handle:horizontal:hover {
    background-color: #ffffff;
    border: 1px solid #42d392;
}

/* 保存/取消按钮 */
QPushButton#saveBtn {
    background-color: #47d99a;
    color: #0f1419;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#saveBtn:hover {
    background-color: #55e3a6;
}
QPushButton#saveBtn:pressed {
    background-color: #37bf83;
}
QPushButton#saveBtn:focus {
    outline: none;
}

QLabel#updateDesc {
    color: #d5dae3;
    font-size: 13px;
    background: transparent;
    line-height: 1.4;
}

QLabel#updateSectionTitle {
    color: #8f96a3;
    font-size: 12px;
    background: transparent;
}

QTextEdit#updateChangelog {
    background-color: #171a20;
    border: 1px solid #303640;
    border-radius: 6px;
    color: #dce2ea;
    padding: 10px;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
    selection-background-color: #2f7d61;
}

QTextEdit#updateChangelog QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 5px 2px 5px 0;
}
QTextEdit#updateChangelog QScrollBar::handle:vertical {
    background-color: #4d5563;
    border-radius: 3px;
    min-height: 24px;
}
QTextEdit#updateChangelog QScrollBar::handle:vertical:hover {
    background-color: #667085;
}
QTextEdit#updateChangelog QScrollBar::add-line:vertical,
QTextEdit#updateChangelog QScrollBar::sub-line:vertical,
QTextEdit#updateChangelog QScrollBar::add-page:vertical,
QTextEdit#updateChangelog QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QLabel#updateStatus {
    color: #8f96a3;
    font-size: 12px;
    background: transparent;
}
QLabel#updateStatus[state="success"] {
    color: #42d392;
}
QLabel#updateStatus[state="error"] {
    color: #ff6b6b;
}

QPushButton#updatePrimaryBtn {
    background-color: #47d99a;
    color: #0f1419;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#updatePrimaryBtn:hover {
    background-color: #55e3a6;
}
QPushButton#updatePrimaryBtn:pressed {
    background-color: #37bf83;
}
QPushButton#updatePrimaryBtn:disabled {
    background-color: #2f5d4a;
    color: #9fb8ad;
}
QPushButton#updatePrimaryBtn:focus {
    outline: none;
}

QPushButton#updateLaterBtn {
    background-color: #20242b;
    color: #a7adb8;
    border: 1px solid #333a45;
    border-radius: 6px;
    font-size: 13px;
}
QPushButton#updateLaterBtn:hover {
    background-color: #282d36;
    color: #f1f4f8;
}
QPushButton#updateLaterBtn:disabled {
    color: #5f6672;
    border-color: #29303a;
}
QPushButton#updateLaterBtn:focus {
    outline: none;
}

QPushButton#cancelBtn {
    background-color: #20242b;
    color: #a7adb8;
    border: 1px solid #333a45;
    border-radius: 6px;
    font-size: 13px;
}
QPushButton#cancelBtn:hover {
    background-color: #282d36;
    color: #f1f4f8;
    border: 1px solid #3f4855;
}
QPushButton#cancelBtn:pressed {
    background-color: #1b1f26;
}
QPushButton#cancelBtn:focus {
    outline: none;
}

/* 测试连接按钮 */
QPushButton#testBtn {
    background-color: #20242b;
    color: #b5bbc6;
    border: 1px solid #333a45;
    border-radius: 6px;
    font-size: 12px;
}
QPushButton#testBtn:hover {
    background-color: #282d36;
    color: #f1f4f8;
    border: 1px solid #3f4855;
}
QPushButton#testBtn:pressed {
    background-color: #1b1f26;
}
QPushButton#testBtn:focus {
    outline: none;
}
QPushButton#tokenBtn {
    background-color: #20242b;
    color: #b5bbc6;
    border: 1px solid #333a45;
    border-radius: 6px;
    font-size: 12px;
}
QPushButton#tokenBtn:hover {
    background-color: #282d36;
    color: #f1f4f8;
    border: 1px solid #3f4855;
}
QPushButton#tokenBtn:pressed {
    background-color: #1b1f26;
}
QPushButton#tokenBtn:focus {
    outline: none;
}

QPushButton#runtimePrimaryBtn {
    background-color: #47d99a;
    color: #0f1419;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#runtimePrimaryBtn:hover {
    background-color: #55e3a6;
}
QPushButton#runtimePrimaryBtn:pressed {
    background-color: #37bf83;
}
QPushButton#runtimePrimaryBtn:disabled {
    background-color: #2f5d4a;
    color: #9fb8ad;
}
QPushButton#runtimePrimaryBtn:focus {
    outline: none;
}
QPushButton#testBtn[state="testing"] {
    background-color: #282d36;
    color: #f1f4f8;
}
QPushButton#testBtn[state="success"] {
    background-color: #172820;
    color: #42d392;
    border: 1px solid #42d392;
    font-weight: bold;
}
QPushButton#testBtn[state="error"] {
    background-color: #2a191c;
    color: #ff5c5c;
    border: 1px solid #ff5c5c;
    font-weight: bold;
}

/* 配置动作按钮（Play/Stop） */
QPushButton#configActionBtn {
    background-color: #3b3d46;
    border: 1px solid #24262d;
    border-radius: 8px;
}
QPushButton#configActionBtn:hover {
    background-color: #454852;
}
QPushButton#configActionBtn:pressed {
    background-color: #333640;
}
QPushButton#configActionBtn:disabled {
    background-color: #30323a;
}
QPushButton#configActionBtn:focus {
    outline: none;
}

QPushButton#configDeleteBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
}
QPushButton#configDeleteBtn:hover {
    background-color: #2f2529;
    border: 1px solid #443039;
}
QPushButton#configDeleteBtn:pressed {
    background-color: #3a252c;
}
QPushButton#configDeleteBtn:disabled {
    background-color: transparent;
    border: 1px solid transparent;
}
QPushButton#configDeleteBtn:focus {
    outline: none;
}

/* 主面板行文本标签 */
QLabel#rowStatusLabel {
    color: #d1d5db;
    font-size: 14px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

/* 日志窗口下拉框与文本面板 */
QComboBox#logConfigCombo, QComboBox#screenshotCombo {
    background-color: #171a20;
    border: 1px solid #2f3540;
    border-radius: 5px;
    color: #f0f0f0;
    padding: 2px 22px 2px 8px;
    font-size: 13px;
    font-family: "Microsoft YaHei", "Segoe UI";
}
QComboBox#logConfigCombo:hover, QComboBox#screenshotCombo:hover {
    background-color: #1a1e25;
    border: 1px solid #3b4350;
}
QComboBox#logConfigCombo:focus, QComboBox#screenshotCombo:focus {
    outline: none;
}
QComboBox#logConfigCombo::drop-down, QComboBox#screenshotCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border: none;
    width: 20px;
}
QComboBox#logConfigCombo::down-arrow, QComboBox#screenshotCombo::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
}
QComboBox#logConfigCombo QAbstractItemView, QComboBox#screenshotCombo QAbstractItemView {
    background-color: #1f2228;
    color: #e6e6e6;
    border: 1px solid #30343f;
    border-radius: 5px;
    selection-background-color: #303641;
    outline: none;
    padding: 4px;
    font-size: 13px;
}

QPushButton#logViewTab {
    background-color: transparent;
    color: #8b8f99;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 3px 10px;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
}
QPushButton#logViewTab:hover {
    background-color: #242a33;
    color: #d1d5db;
}
QPushButton#logViewTab[active="true"] {
    background-color: #2b313b;
    color: #42d392;
    border: 1px solid #3a414d;
}
QPushButton#logViewTab:focus {
    outline: none;
}

QLabel#screenshotFieldLabel {
    color: #8b8f99;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

QLabel#screenshotStatusLabel {
    color: #9ca3af;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

QFrame#screenshotImagePanel {
    background-color: #171a20;
    border: 1px solid #2f3540;
    border-radius: 8px;
}

QLabel#screenshotImageLabel {
    color: #9ca3af;
    background: transparent;
    font-size: 13px;
    font-family: "Microsoft YaHei", "Segoe UI";
}

QPushButton#screenshotRefreshBtn {
    background-color: #2b313b;
    color: #cfd3dc;
    border: 1px solid #3a414d;
    border-radius: 5px;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
}
QPushButton#screenshotRefreshBtn:hover {
    background-color: #343b47;
    color: #ffffff;
    border: 1px solid #4b5563;
}
QPushButton#screenshotRefreshBtn:pressed {
    background-color: #20252e;
}
QPushButton#screenshotRefreshBtn:disabled {
    color: #6b7280;
    background-color: #202329;
    border: 1px solid #2b3039;
}
QPushButton#screenshotRefreshBtn:focus {
    outline: none;
}

QTextEdit#logTextPanel {
    background-color: #171a20;
    color: #cfd3dc;
    border: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 10px 16px 16px 10px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    line-height: 1.5;
}
QTextEdit#logTextPanel QScrollBar:vertical {
    border: none;
    background: #171a20;
    width: 8px;
    margin: 8px 3px 8px 0px;
}
QTextEdit#logTextPanel QScrollBar::handle:vertical {
    background: #343a45;
    min-height: 20px;
    border-radius: 4px;
}
QTextEdit#logTextPanel QScrollBar::handle:vertical:hover {
    background: #4b5563;
}
QTextEdit#logTextPanel QScrollBar::add-line:vertical, QTextEdit#logTextPanel QScrollBar::sub-line:vertical {
    height: 0px;
}
QTextEdit#logTextPanel QScrollBar::add-page:vertical, QTextEdit#logTextPanel QScrollBar::sub-page:vertical {
    background: transparent;
}
QTextEdit#logTextPanel QScrollBar:horizontal {
    border: none;
    background: #171a20;
    height: 8px;
    margin: 0px 8px 3px 8px;
}
QTextEdit#logTextPanel QScrollBar::handle:horizontal {
    background: #343a45;
    min-width: 20px;
    border-radius: 4px;
}
QTextEdit#logTextPanel QScrollBar::handle:horizontal:hover {
    background: #4b5563;
}
QTextEdit#logTextPanel QScrollBar::add-line:horizontal, QTextEdit#logTextPanel QScrollBar::sub-line:horizontal {
    width: 0px;
}
QTextEdit#logTextPanel QScrollBar::add-page:horizontal, QTextEdit#logTextPanel QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* 悬浮窗面板 */
QFrame#miniBg {
    background-color: rgba(30, 32, 40, 240);
    border-radius: 12px;
    border: 1px solid #3b3e4b;
}
QPushButton#miniRestoreBtn {
    background: transparent;
    color: #a6abb4;
    border: none;
    font-size: 11px;
    padding: 2px 8px;
}
QPushButton#miniRestoreBtn:hover {
    color: #42d392;
}
QPushButton#miniRestoreBtn:focus {
    outline: none;
}
QFrame#miniDivider {
    background-color: #3b3e4b;
}
QLabel#miniStatusLabel {
    color: #d1d5db;
    font-size: 13px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

QPushButton#lineIconBtn {
    background-color: transparent;
    border: none;
}
QPushButton#lineIconBtn:hover {
    background-color: transparent;
    border: none;
}
QPushButton#lineIconBtn:focus {
    outline: none;
}

QFrame#messageCard {
    background-color: #262a31;
    border: 1px solid #1b1e24;
    border-radius: 0px;
}

QWidget#messageTopBg {
    background-color: #191c21;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom: 1px solid #111419;
}

QWidget#messageBodyBg {
    background-color: transparent;
    border: none;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QLabel#messageTitle {
    color: #c8ccd5;
    font-size: 12px;
    font-weight: normal;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

QLabel#messageText {
    color: #e3e8ef;
    font-size: 13px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
    line-height: 1.45;
}

QPushButton#messagePrimaryBtn {
    background-color: #47d99a;
    color: #0f1419;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#messagePrimaryBtn:hover {
    background-color: #55e3a6;
}
QPushButton#messagePrimaryBtn:pressed {
    background-color: #37bf83;
}
QPushButton#messagePrimaryBtn:focus {
    outline: none;
}

QPushButton#messageDangerBtn {
    background-color: #ff6b6b;
    color: #16191f;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#messageDangerBtn:hover {
    background-color: #ff7f7f;
}
QPushButton#messageDangerBtn:pressed {
    background-color: #e95a5a;
}
QPushButton#messageDangerBtn:focus {
    outline: none;
}

QPushButton#messageSecondaryBtn {
    background-color: #20242c;
    color: #aeb5c0;
    border: 1px solid #303640;
    border-radius: 6px;
    font-size: 13px;
}
QPushButton#messageSecondaryBtn:hover {
    background-color: #2a2f38;
    color: #d7dce5;
    border: 1px solid #3c4655;
}
QPushButton#messageSecondaryBtn:pressed {
    background-color: #171a20;
}
QPushButton#messageSecondaryBtn:focus {
    outline: none;
}
