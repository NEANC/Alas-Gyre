/* 主卡片 */
QWidget#mainWindow,
QDialog#settingsWindow,
QDialog#logWindow,
QDialog#screenshotWindow,
QDialog#initWindow,
QDialog#updateWindow,
QDialog#messageDialog {
    background-color: #ffffff;
}

QFrame#card, QFrame#settingsCard, QFrame#logCard, QFrame#screenshotCard, QFrame#initCard, QFrame#updateCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0px;
}

QToolTip {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
}

QWidget#configListBg {
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}

QWidget#compactCtrlBg {
    background-color: #f1f5f9;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom: 1px solid #e2e8f0;
}

QWidget#mainBottomBg {
    background-color: #f8fafc;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

/* 窗口控制区 */
QWidget#windowCtrlBg {
    background-color: #f1f5f9;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom: 1px solid #e2e8f0;
}

QWidget#topBg {
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}

QWidget#settingsTopBg, QWidget#logTopBg, QWidget#screenshotTopBg, QWidget#initTopBg, QWidget#updateTopBg {
    background-color: #f1f5f9;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom: 1px solid #e2e8f0;
}

/* 中下区域背景 */
QWidget#midBg, QWidget#settingsFormBg, QWidget#screenshotBodyBg, QWidget#initBodyBg, QWidget#updateBodyBg {
    background-color: transparent;
    border: none;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QLabel#configLabel {
    color: #0f172a;
    font-size: 14px;
    background: transparent;
    border: none;
}

QLabel#statusLabel {
    color: #475569;
    font-size: 13px;
    background: transparent;
}

QLabel#sectionTitle, QLabel#settingsTitle {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}

QLabel#settingsTitle, QLabel#logTitle, QLabel#screenshotTitle, QLabel#initTitle {
    color: #334155;
    font-size: 12px;
    font-weight: normal;
    font-family: "Microsoft YaHei", "Segoe UI";
}

QLabel#initDesc, QLabel#initHint {
    color: #334155;
    font-size: 13px;
    background: transparent;
}

QLabel#initStepProgress {
    color: #059669;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#initStepTitle {
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

QLabel#initStepDesc {
    color: #475569;
    font-size: 13px;
    background: transparent;
    line-height: 1.4;
}

QFrame#initStepRail {
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
}

QFrame#initStepNavItem {
    background: transparent;
    border: none;
}

QLabel#initStepBadge {
    background-color: #e2e8f0;
    color: #64748b;
    border: 1px solid #cbd5e1;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#initStepBadge[active="true"] {
    background-color: #10b981;
    color: #ffffff;
    border: 1px solid #10b981;
}
QLabel#initStepBadge[done="true"] {
    background-color: #d1fae5;
    color: #047857;
    border: 1px solid #10b981;
}

QLabel#initStepNavLabel {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}
QLabel#initStepNavLabel[active="true"] {
    color: #0f172a;
    font-weight: 600;
}
QLabel#initStepNavLabel[done="true"] {
    color: #047857;
}

QLabel#initSubtle {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}

QStackedWidget#initStepStack, QWidget#initStepPage {
    background: transparent;
}

QFrame#initPanel {
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
}

QFrame#initEmergencyPanel {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
}

QLabel#initPanelTitle {
    color: #0f172a;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QLabel#initStatus {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}
QLabel#initStatus[state="success"] {
    color: #10b981;
}
QLabel#initStatus[state="error"] {
    color: #ef4444;
}

QLabel#formLabel {
    color: #334155;
    font-size: 13px;
}

QLabel#settingsSectionLabel {
    color: #047857;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    padding-top: 2px;
}

QFrame#settingsSidebar {
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
}

QPushButton#settingsNavButton {
    background-color: transparent;
    color: #475569;
    border: 1px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 12px;
    font-size: 13px;
}
QPushButton#settingsNavButton:hover {
    background-color: #e2e8f0;
    color: #0f172a;
}
QPushButton#settingsNavButton[active="true"] {
    background-color: #ecfdf5;
    color: #047857;
    border: 1px solid #bbf7d0;
    font-weight: 600;
}
QPushButton#settingsNavButton:focus {
    outline: none;
}

QStackedWidget#settingsStack, QWidget#settingsPage {
    background: transparent;
}

QWidget#settingsPageHeader {
    background: transparent;
}

QLabel#settingsPageTitle {
    color: #0f172a;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}

QLabel#settingsPageDesc {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}

QFrame#settingsPanel {
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
}

QLabel#sliderValueLabel {
    color: #475569;
    font-size: 12px;
    background: transparent;
}

/* 配置下拉框 */
QComboBox {
    background: transparent;
    border: none;
    color: transparent;
    font-size: 14px;
    padding: 0px;
}
QComboBox::drop-down {
    border: none;
    width: 0px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #f1f5f9;
    font-size: 13px;
    padding: 4px;
}

/* 底部图标按钮 */
QPushButton.iconBtn {
    background-color: transparent;
    border: none;
    outline: none;
}
QPushButton.iconBtn:hover {
    background-color: rgba(0, 0, 0, 15);
    border: none;
}
QPushButton.iconBtn:focus {
    outline: none;
    border: none;
}

QPushButton#lineIconBtn, BottomIconButton#lineIconBtn, #lineIconBtn {
    background-color: transparent;
    border: none;
    outline: none;
}
QPushButton#lineIconBtn:hover, BottomIconButton#lineIconBtn:hover, #lineIconBtn:hover {
    background-color: #cbd5e1;
    border: none;
}
QPushButton#lineIconBtn:pressed, BottomIconButton#lineIconBtn:pressed, #lineIconBtn:pressed {
    background-color: #b8c5d6;
    border: none;
}
QPushButton#lineIconBtn:focus, BottomIconButton#lineIconBtn:focus, #lineIconBtn:focus {
    outline: none;
    border: none;
}

/* Unicode 文本图标按钮 */
QPushButton#unicodeIconBtn {
    background-color: transparent;
    border: none;
    color: #64748b;
    font-size: 22px;
    font-family: "Segoe UI Symbol", "Segoe UI", "Microsoft YaHei";
    padding-bottom: 2px;
}
QPushButton#unicodeIconBtn:hover {
    color: #0f172a;
}
QPushButton#unicodeIconBtn:focus {
    outline: none;
}

/* 设置窗口关闭按钮 */
QPushButton#settingsCloseBtn, QPushButton#logCloseBtn, QPushButton#initCloseBtn {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 14px;
    font-weight: normal;
    padding: 0px;
}
QPushButton#settingsCloseBtn:hover, QPushButton#logCloseBtn:hover:hover, QPushButton#initCloseBtn:hover {
    background-color: #e11d48;
    color: #ffffff;
}
QPushButton#settingsCloseBtn:pressed, QPushButton#logCloseBtn:pressed:pressed, QPushButton#initCloseBtn:pressed {
    background-color: #be123c;
    color: #ffffff;
}
QPushButton#settingsCloseBtn:focus, QPushButton#logCloseBtn:focus:focus, QPushButton#initCloseBtn:focus {
    outline: none;
}

/* 表单输入框 */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    color: #0f172a;
    padding: 4px 8px;
    font-size: 13px;
}
QLineEdit:focus {
    border: 1px solid #10b981;
}

QLineEdit#settingsInput {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    color: #0f172a;
    padding: 0px 10px;
    font-size: 13px;
    selection-background-color: #a7f3d0;
}
QLineEdit#settingsInput:hover {
    background-color: #f8fafc;
    border: 1px solid #94a3b8;
}
QLineEdit#settingsInput:focus {
    background-color: #ffffff;
    border: 1px solid #10b981;
}
QComboBox#settingsInput {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    color: #0f172a;
    padding: 0px 28px 0px 10px;
    font-size: 13px;
    selection-background-color: #a7f3d0;
}
QComboBox#settingsInput:hover {
    background-color: #f8fafc;
    border: 1px solid #94a3b8;
}
QComboBox#settingsInput:focus {
    background-color: #ffffff;
    border: 1px solid #10b981;
}
QComboBox#settingsInput::drop-down {
    border: none;
    width: 24px;
}
QComboBox#settingsInput QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #a7f3d0;
    font-size: 13px;
}

/* 复选框 */
QCheckBox {
    color: #334155;
    font-size: 13px;
    spacing: 7px;
    min-height: 22px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 5px;
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
}
QCheckBox::indicator:hover {
    border: 1px solid #10b981;
}
QCheckBox::indicator:checked {
    background-color: #ffffff;
    border: 1px solid #10b981;
    image: none;
}
QCheckBox::indicator:checked:hover {
    border: 1px solid #34d399;
}

QSlider#settingsSlider::groove:horizontal {
    height: 4px;
    background-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
}
QSlider#settingsSlider::sub-page:horizontal {
    background-color: #10b981;
    border-radius: 3px;
}
QSlider#settingsSlider::add-page:horizontal {
    background-color: #e2e8f0;
    border-radius: 3px;
}
QSlider#settingsSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -6px 0px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
}
QSlider#settingsSlider::handle:horizontal:hover {
    background-color: #ffffff;
    border: 1px solid #10b981;
}

/* 保存/取消按钮 */
QPushButton#saveBtn {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#saveBtn:hover {
    background-color: #059669;
}
QPushButton#saveBtn:pressed {
    background-color: #047857;
}
QPushButton#saveBtn:focus {
    outline: none;
}

QPushButton#cancelBtn {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 13px;
}
QPushButton#cancelBtn:hover {
    background-color: #e2e8f0;
    color: #0f172a;
    border: 1px solid #94a3b8;
}
QPushButton#cancelBtn:pressed {
    background-color: #cbd5e1;
}
QPushButton#cancelBtn:focus {
    outline: none;
}

/* 测试连接按钮 */
QPushButton#testBtn {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 12px;
}
QPushButton#testBtn:hover {
    background-color: #e2e8f0;
    color: #0f172a;
    border: 1px solid #94a3b8;
}
QPushButton#testBtn:pressed {
    background-color: #cbd5e1;
}
QPushButton#testBtn:focus {
    outline: none;
}
QPushButton#tokenBtn {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 12px;
}
QPushButton#tokenBtn:hover {
    background-color: #e2e8f0;
    color: #0f172a;
    border: 1px solid #94a3b8;
}
QPushButton#tokenBtn:pressed {
    background-color: #cbd5e1;
}
QPushButton#tokenBtn:focus {
    outline: none;
}

QPushButton#runtimePrimaryBtn {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#runtimePrimaryBtn:hover {
    background-color: #059669;
}
QPushButton#runtimePrimaryBtn:pressed {
    background-color: #047857;
}
QPushButton#runtimePrimaryBtn:disabled {
    background-color: #d1fae5;
    color: #64748b;
}
QPushButton#runtimePrimaryBtn:focus {
    outline: none;
}
QPushButton#testBtn[state="testing"] {
    background-color: #e2e8f0;
    color: #0f172a;
}
QPushButton#testBtn[state="success"] {
    background-color: #d1fae5;
    color: #065f46;
    border: 1px solid #10b981;
    font-weight: bold;
}
QPushButton#testBtn[state="error"] {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #ef4444;
    font-weight: bold;
}

/* 配置动作按钮（Play/Stop） */
QPushButton#configActionBtn {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
}
QPushButton#configActionBtn:hover {
    background-color: #e2e8f0;
}
QPushButton#configActionBtn:pressed {
    background-color: #cbd5e1;
}
QPushButton#configActionBtn:disabled {
    background-color: #f8fafc;
}
QPushButton#configActionBtn:focus {
    outline: none;
}

QPushButton#configDeleteBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
}
QPushButton#configDeleteBtn:hover {
    background-color: #fee2e2;
    border: 1px solid #fecaca;
}
QPushButton#configDeleteBtn:pressed {
    background-color: #fecaca;
}
QPushButton#configDeleteBtn:disabled {
    background-color: transparent;
    border: 1px solid transparent;
}
QPushButton#configDeleteBtn:focus {
    outline: none;
}

/* 主面板行文本标签 */
QLabel#rowStatusLabel {
    color: #1e293b;
    font-size: 14px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

/* 日志窗口下拉框与文本面板 */
QComboBox#logConfigCombo, QComboBox#screenshotCombo {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    color: #0f172a;
    padding: 2px 22px 2px 8px;
    font-size: 13px;
    font-family: "Microsoft YaHei", "Segoe UI";
}
QComboBox#logConfigCombo:hover, QComboBox#screenshotCombo:hover {
    background-color: #f8fafc;
    border: 1px solid #94a3b8;
}
QComboBox#logConfigCombo:focus, QComboBox#screenshotCombo:focus {
    outline: none;
}
QComboBox#logConfigCombo::drop-down, QComboBox#screenshotCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border: none;
    width: 20px;
}
QComboBox#logConfigCombo::down-arrow, QComboBox#screenshotCombo::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
}
QComboBox#logConfigCombo QAbstractItemView, QComboBox#screenshotCombo QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    selection-background-color: #f1f5f9;
    outline: none;
    padding: 4px;
    font-size: 13px;
}

QPushButton#logViewTab {
    background-color: transparent;
    color: #64748b;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 3px 10px;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
}
QPushButton#logViewTab:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}
QPushButton#logViewTab[active="true"] {
    background-color: #ecfdf5;
    color: #047857;
    border: 1px solid #bbf7d0;
}
QPushButton#logViewTab:focus {
    outline: none;
}

QLabel#screenshotFieldLabel {
    color: #64748b;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

QLabel#screenshotStatusLabel {
    color: #64748b;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

QFrame#screenshotImagePanel {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
}

QLabel#screenshotImageLabel {
    color: #64748b;
    background: transparent;
    font-size: 13px;
    font-family: "Microsoft YaHei", "Segoe UI";
}

QPushButton#screenshotRefreshBtn {
    background-color: #f8fafc;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    font-size: 12px;
    font-family: "Microsoft YaHei", "Segoe UI";
}
QPushButton#screenshotRefreshBtn:hover {
    background-color: #eef2f7;
    color: #0f172a;
    border: 1px solid #94a3b8;
}
QPushButton#screenshotRefreshBtn:pressed {
    background-color: #e2e8f0;
}
QPushButton#screenshotRefreshBtn:disabled {
    color: #94a3b8;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
}
QPushButton#screenshotRefreshBtn:focus {
    outline: none;
}

QTextEdit#logTextPanel {
    background-color: #ffffff;
    color: #334155;
    border: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 10px 16px 16px 10px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    line-height: 1.5;
}
QTextEdit#logTextPanel QScrollBar:vertical {
    border: none;
    background: #ffffff;
    width: 8px;
    margin: 8px 3px 8px 0px;
}
QTextEdit#logTextPanel QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 20px;
    border-radius: 4px;
}
QTextEdit#logTextPanel QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QTextEdit#logTextPanel QScrollBar::add-line:vertical, QTextEdit#logTextPanel QScrollBar::sub-line:vertical {
    height: 0px;
}
QTextEdit#logTextPanel QScrollBar::add-page:vertical, QTextEdit#logTextPanel QScrollBar::sub-page:vertical {
    background: transparent;
}
QTextEdit#logTextPanel QScrollBar:horizontal {
    border: none;
    background: #ffffff;
    height: 8px;
    margin: 0px 8px 3px 8px;
}
QTextEdit#logTextPanel QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 20px;
    border-radius: 4px;
}
QTextEdit#logTextPanel QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}
QTextEdit#logTextPanel QScrollBar::add-line:horizontal, QTextEdit#logTextPanel QScrollBar::sub-line:horizontal {
    width: 0px;
}
QTextEdit#logTextPanel QScrollBar::add-page:horizontal, QTextEdit#logTextPanel QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* 悬浮窗面板 */
QFrame#miniBg {
    background-color: rgba(255, 255, 255, 245);
    border-radius: 12px;
    border: 1px solid #cbd5e1;
}
QPushButton#miniRestoreBtn {
    background: transparent;
    color: #64748b;
    border: none;
    font-size: 11px;
    padding: 2px 8px;
}
QPushButton#miniRestoreBtn:hover {
    color: #10b981;
}
QPushButton#miniRestoreBtn:focus {
    outline: none;
}
QFrame#miniDivider {
    background-color: #cbd5e1;
}
QLabel#miniStatusLabel {
    color: #1e293b;
    font-size: 13px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

QFrame#messageCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0px;
}

QWidget#messageTopBg {
    background-color: #f1f5f9;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom: 1px solid #e2e8f0;
}

QWidget#messageBodyBg {
    background-color: transparent;
    border: none;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QLabel#messageTitle {
    color: #334155;
    font-size: 12px;
    font-weight: normal;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
}

QLabel#messageText {
    color: #1e293b;
    font-size: 13px;
    font-family: "Microsoft YaHei", "Segoe UI";
    background: transparent;
    line-height: 1.45;
}

QPushButton#messagePrimaryBtn {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#messagePrimaryBtn:hover {
    background-color: #059669;
}
QPushButton#messagePrimaryBtn:pressed {
    background-color: #047857;
}
QPushButton#messagePrimaryBtn:focus {
    outline: none;
}

QPushButton#messageDangerBtn {
    background-color: #ef4444;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#messageDangerBtn:hover {
    background-color: #dc2626;
}
QPushButton#messageDangerBtn:pressed {
    background-color: #b91c1c;
}
QPushButton#messageDangerBtn:focus {
    outline: none;
}

QPushButton#messageSecondaryBtn {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 13px;
}
QPushButton#messageSecondaryBtn:hover {
    background-color: #e2e8f0;
    color: #0f172a;
    border: 1px solid #94a3b8;
}
QPushButton#messageSecondaryBtn:pressed {
    background-color: #cbd5e1;
}
QPushButton#messageSecondaryBtn:focus {
    outline: none;
}
